DATABASE_URL=postgres://postgres:zitie-dev@localhost:5432/zitie
WEB_ORIGIN=http://localhost:5173
PORT=8787
NODE_ENV=development
EMAIL_FROM=Zitie <onboarding@resend.dev>
RESEND_API_KEY=
ANTHROPIC_API_KEY=

# Azure Speech — synthesises the pronunciation clips served from
# character_audio. Only the seeding step needs these; the app itself just
# reads rows, so a deploy without them still runs (silently, falling back to
# the browser's own voice). Create a Speech resource in the Azure portal.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Optional. Defaults to zh-CN-XiaoxiaoNeural.
AZURE_SPEECH_VOICE=
